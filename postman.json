{
  "info": {
    "name": "NEXUS | Catálogo",
    "description": "Colección para el catálogo local. Ejecuta en orden. Las dos primeras solicitudes crean productos con un prefijo único por ejecución para verificar filtros y paginación.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "missingProductId",
      "value": "00000000-0000-4000-8000-000000000000",
      "type": "string"
    },
    {
      "key": "searchName",
      "value": "",
      "type": "string"
    },
    {
      "key": "secondProductId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Crear producto",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"searchName\", \"Nexus-\" + pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set(\"productId\", \"\");",
              "if (pm.response.code === 201) {",
              "    const product = pm.response.json();",
              "    pm.test(\"El producto está activo y Location apunta a su ID\", function () {",
              "        pm.expect(product.id).to.be.a(\"string\").and.not.be.empty;",
              "        pm.expect(product.active).to.equal(true);",
              "        pm.expect(pm.response.headers.get(\"Location\")).to.be.a(\"string\").and.include(\"/api/v1/products/\" + product.id);",
              "    });",
              "    if (product.id) pm.collectionVariables.set(\"productId\", product.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "products"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{searchName}} A\",\n  \"description\": \"Producto de prueba A\",\n  \"price\": 29.9\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "2. Crear segundo producto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set(\"secondProductId\", \"\");",
              "if (pm.response.code === 201) {",
              "    const product = pm.response.json();",
              "    pm.test(\"El producto está activo y Location apunta a su ID\", function () {",
              "        pm.expect(product.id).to.be.a(\"string\").and.not.be.empty;",
              "        pm.expect(product.active).to.equal(true);",
              "        pm.expect(pm.response.headers.get(\"Location\")).to.be.a(\"string\").and.include(\"/api/v1/products/\" + product.id);",
              "    });",
              "    if (product.id) pm.collectionVariables.set(\"secondProductId\", product.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "products"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{searchName}} B\",\n  \"description\": \"Producto de prueba B\",\n  \"price\": 39.9\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "3. Consultar el producto creado",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Devuelve el producto activo creado\", function () {",
              "    const product = pm.response.json();",
              "    pm.expect(product.id).to.equal(pm.collectionVariables.get(\"productId\"));",
              "    pm.expect(product.active).to.equal(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "products",
            "{{productId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "4. Filtrar por nombre y consultar la primera página",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Devuelve un producto activo con la paginación esperada\", function () {",
              "    const products = pm.response.json();",
              "    pm.expect(products).to.have.lengthOf(1);",
              "    pm.expect(products[0].id).to.equal(pm.collectionVariables.get(\"productId\"));",
              "    pm.expect(products[0].active).to.equal(true);",
              "    pm.expect(pm.response.headers.get(\"X-Has-Next\")).to.equal(\"true\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/products?page=0&size=1&name={{searchName}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "products"
          ],
          "query": [
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "1"
            },
            {
              "key": "name",
              "value": "{{searchName}}"
            }
          ]
        }
      },
      "response": []
    },
